# Copy to .env and fill in.  .env is gitignored; this file is NOT.

# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-key-here

# Writes the user-facing answer. Bump to gpt-5.6-terra if the eval harness
# shows a low grounding rate on gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Intent classifier + reranker + citation-support judge. High call volume,
# so keep this cheap.
OPENAI_GUARD_MODEL=gpt-4o-mini

# Embeddings are a separate model from the chat model above.
OPENAI_EMBED_MODEL=text-embedding-3-large
EMBED_DIM=3072

# --- LanceDB --------------------------------------------------------------
# Your self-hosted server endpoint (db://... or https://...).
# Leave commented out to fall back to an embedded local dir at data/lancedb,
# which is what the tests use.
# LANCEDB_URI=db://your-host
# LANCEDB_API_KEY=
# LANCEDB_REGION=

TABLE_NAME=guidelines
# Bump this to rebuild the index from scratch without clobbering the old one.
INDEX_VERSION=v1

# --- Cache (Upstash Redis) ------------------------------------------------
# Optional. Leave unset and the app runs exactly as before, with an in-process
# cache only. Use the TCP endpoint from the Upstash console ("redis-py" tab),
# not the REST URL -- rag-serve and rag-ui are long-lived processes, so a
# pooled TLS connection beats a per-call REST round-trip.
# REDIS_URL=rediss://default:YOUR_TOKEN@YOUR-ENDPOINT.upstash.io:6379

# Abandon a lookup that has not returned in this long and just compute the
# answer. A cache may never add latency to a query.
REDIS_TIMEOUT_MS=400

# Query vectors: exact mapping, safe to keep for a month.
CACHE_EMBED_TTL_S=2592000
# Whole answers: capped at a day so guidance cannot circulate stale for long.
CACHE_RESPONSE_TTL_S=86400
