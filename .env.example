# Copy to .env and fill in.  .env is gitignored; this file is NOT.

# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-key-here

# Writes the user-facing answer. Bump to gpt-5.6-terra if the eval harness
# shows a low grounding rate on gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Intent classifier + reranker + citation-support judge. High call volume,
# so keep this cheap.
OPENAI_GUARD_MODEL=gpt-4o-mini

# Embeddings are a separate model from the chat model above.
OPENAI_EMBED_MODEL=text-embedding-3-large
EMBED_DIM=3072

# --- LanceDB --------------------------------------------------------------
# Your self-hosted server endpoint (db://... or https://...).
# Leave commented out to fall back to an embedded local dir at data/lancedb,
# which is what the tests use.
# LANCEDB_URI=db://your-host
# LANCEDB_API_KEY=
# LANCEDB_REGION=

TABLE_NAME=guidelines
# Bump this to rebuild the index from scratch without clobbering the old one.
INDEX_VERSION=v1

# --- Cache (Upstash Redis) ------------------------------------------------
# Optional. Leave unset and the app runs exactly as before, with an in-process
# cache only. Use the TCP endpoint from the Upstash console ("redis-py" tab),
# not the REST URL -- rag-serve is a long-lived process, so a
# pooled TLS connection beats a per-call REST round-trip.
# REDIS_URL=rediss://default:YOUR_TOKEN@YOUR-ENDPOINT.upstash.io:6379

# Abandon a lookup that has not returned in this long and just compute the
# answer. A cache may never add latency to a query.
REDIS_TIMEOUT_MS=400

# Query vectors: exact mapping, safe to keep for a month.
CACHE_EMBED_TTL_S=2592000
# Whole answers: capped at a day so guidance cannot circulate stale for long.
CACHE_RESPONSE_TTL_S=86400

# --- Accounts and history (Postgres / Supabase) ---------------------------
# Where users and their question history live. Any Postgres URL works. Setting
# it is also what turns the login gate on: visitors then sign up or sign in,
# and every question is filed under the account that asked it.
#
# Neon: Dashboard -> Connection Details -> *Pooled connection*. Take the host
# with "-pooler" in it, not the direct one: a serverless deployment opens a
# connection per instance and will exhaust the direct endpoint's slots.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
#
# Supabase: Project settings -> Database -> Connection string -> URI, using the
# pooler on port 6543 rather than the direct connection on 5432.
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Leave DATABASE_URL unset and accounts fall back to a local SQLite file,
# which is right for local work and wrong for a deployment: Vercel's filesystem
# is ephemeral, so every account and every saved question disappears at the
# next cold start. Override the location if you want it somewhere specific.
# SQLITE_PATH=data/app.db

# Postgres pool size, per process. Small on purpose: a serverless deployment
# multiplies this by the number of warm instances.
DB_MAX_CONNECTIONS=4
# Generous because Neon scales to zero -- the first query after an idle period
# waits a few hundred milliseconds for the compute to wake.
DB_TIMEOUT_S=10

# --- Access control -------------------------------------------------------
# Signs the session cookie. REQUIRED for any real deployment -- with no value
# the app invents a random key per process, so every restart signs everyone out
# and two instances never agree on a session. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# SESSION_SECRET=

# Force the gate on or off regardless of DATABASE_URL. Unset means "on when a
# database is configured", which is usually what you want.
# AUTH_ENABLED=true

# Deprecated: the shared password from before accounts existed. It is no longer
# accepted as a credential -- it only keeps the login gate on, so that an
# instance that was private before an upgrade does not silently become public.
# Delete it once DATABASE_URL is set.
# APP_PASSWORD=

# How long a session lasts. Rotating SESSION_SECRET invalidates all of them.
SESSION_TTL_S=604800

# scrypt work factors for password hashing. n must be a power of two; raising
# it re-hashes on next login rather than locking anyone out.
SCRYPT_N=16384
SCRYPT_R=8
SCRYPT_P=1

# Turns kept per account; the oldest are dropped on write. 0 keeps everything.
HISTORY_MAX_ITEMS=200

# --- Email (Amazon SES, over SMTP) ----------------------------------------
# Setting a host is what turns email verification on. Leave it unset and
# accounts work the moment they are created -- which is what local work and
# the test suite need, and what an instance that cannot send must do rather
# than demand a link it will never deliver.
#
# Credentials: SES console -> SMTP settings -> Create SMTP credentials. These
# are NOT your AWS access keys; SES derives a separate pair for SMTP.
# SES_SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# 587 uses STARTTLS, 465 implicit TLS. The port picks the handshake.
SES_SMTP_PORT=587
# SES_SMTP_USER=AKIA...
# SES_SMTP_PASSWORD=

# The sender. Must be an address or domain you have verified in SES, or every
# send is rejected.
# MAIL_FROM=noreply@yourdomain.in
MAIL_FROM_NAME=Medical Guideline Assistant
MAIL_TIMEOUT_S=10

# Absolute base for links in emails. Derived from the request when empty, which
# is right locally and behind an honest proxy -- but Host is attacker-supplied
# in general, and a confirmation link pointing elsewhere is a dead account. Set
# it for any real deployment.
# PUBLIC_BASE_URL=https://your-app.vercel.app

# Confirmation links last three days; reset links one hour and one use.
VERIFY_TOKEN_TTL_S=259200
RESET_TOKEN_TTL_S=3600

# NOTE: a new SES account is in the *sandbox*, where it will only deliver to
# addresses you have verified in the console, and signing up with any other
# address gets a clean "we could not send it". Request production access in the
# SES console before letting real people register.

# Questions per window, counted per account once signed in and per IP before
# that. A spend control, not a security boundary -- signup is open, so anyone
# stopped by this can register again; put a hard monthly limit on a
# project-scoped OpenAI key as the real backstop. Sign-in and sign-up are
# counted separately, so failed logins never eat the question quota.
#
# Five an hour is deliberately tight: one question can cost an intent call, an
# embedding, a HyDE generation, up to 40 rerank calls, an answer and two
# output-gate checks. Raise it for a deployment with known users; 0 disables.
RATE_LIMIT_PER_WINDOW=5
RATE_LIMIT_WINDOW_S=3600

# Read the client IP from x-forwarded-for. Correct behind Vercel; turn it off
# if the app is ever exposed directly, where a client could forge the header.
TRUST_PROXY_HEADER=true

