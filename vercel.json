      "maxDuration": 60,
      "includeFiles": "{src/**,data/chunks/**,data/calibration.json,data/index_manifest.json}",
      "excludeFiles": "{tests/**,**/test_*.py,.venv/**,.pytest_cache/**,**/__pycache__/**,data/embed_cache/**,data/lancedb/**,data/raw/**,pdf-data/**}"
    }
  }
}
